{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.exclude": {
    "**.cache": true,
    "**.vscode": false,
    "**node_modules": true,
    "**public": false,
    "**.gitignore": false,
    "**.prettierrc": false,
    "**yarn.lock": false
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "astro"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [
    {
      "directory": ".",
      "!cwd": true
    },
    {
      "directory": "apps/website-astro"
    },
    {
      "directory": "apps/curation-bot"
    },
    {
      "directory": "apps/cms-prismic"
    }
  ]
}
