{
  "name": "sebastien-rigaux-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.22.1"
  },
  "imports": {
    "#curate-scrape": "./.agents/skills/curate-prismic-link/scripts/scrape.mjs",
    "#curate-send": "./.agents/skills/curate-prismic-link/scripts/send-prismic.mjs",
    "#watch-markdown": "./apps/website-astro/src/lib/watch-markdown.ts",
    "#watch-model": "./apps/website-astro/src/lib/watch-model.ts",
    "#site-sitemap": "./apps/website-astro/src/integrations/site-sitemap.mjs",
    "#site-urls": "./apps/website-astro/src/lib/urls.ts"
  },
  "scripts": {
    "dev": "pnpm --filter website-astro dev",
    "build": "pnpm --filter website-astro build",
    "preview": "pnpm --filter website-astro preview",
    "astro": "pnpm --filter website-astro exec astro",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test && node --test tests/*.test.mjs",
    "test:watch": "pnpm --filter website-astro test && node --test tests/*.test.mjs",
    "check:watch-build": "pnpm --filter website-astro check:watch-build"
  },
  "dependencies": {
    "@prismicio/client": "^7.22.3"
  }
}
