{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sebastien-rigaux-curation-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issue_detection": {
      "enabled": true,
    },
  },
  "vars": {
    "PRISMIC_REPOSITORY": "bd7d5fa0",
    "OPENAI_MODEL": "gpt-6-luna",
    "PUBLISH_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curation-bot",
      "database_id": "6343b926-1b34-4884-a28a-9d3a83229b81",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "curation-bot-private",
    },
  ],
  "workflows": [
    {
      "binding": "CURATION",
      "name": "curation",
      "class_name": "CurationWorkflow",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
}
