{
  "name": "curation-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "logs": "wrangler tail --format pretty",
    "logs:json": "wrangler tail --format json",
    "check": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "test:scripts": "node --test scripts/*.node-test.mjs",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "telegram:webhook": "node --env-file=.dev.vars scripts/webhook.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "format": "pnpm -w exec prettier --write apps/curation-bot",
    "format:check": "pnpm -w exec prettier --check apps/curation-bot",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.117",
    "@prismicio/client": "7.23.1",
    "ai": "^7.0.172",
    "cms-prismic": "workspace:*",
    "context.dev": "^3.29.0",
    "grammy": "^1.46.0",
    "markdown-it": "^15.0.3",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
