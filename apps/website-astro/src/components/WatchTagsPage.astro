---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/Header.astro'
import CookieSettings from '@/components/CookieSettings.astro'
import { ChevronDown, SlidersHorizontal } from '@lucide/astro'
import { getWatchData } from '@/lib/watch-prismic'
import { watchPath, type WatchTopic } from '@/lib/watch-model'
import type { Locale } from '@/types'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const { topics } = await getWatchData(locale)
const tags = topics.filter((tag) => tag.status !== 'retired')
const title = locale === 'fr' ? 'Tous les tags' : 'All tags'
const paths = { fr: '/veille/tags/', en: '/en/tech-watch/tags/' }
const categories = [
  ['language', 'Langages', 'Languages'],
  [
    'framework-library',
    'Frameworks et bibliothèques',
    'Frameworks and libraries',
  ],
  ['tool-application', 'Outils et applications', 'Tools and applications'],
  [
    'platform-infrastructure',
    'Plateformes et infrastructure',
    'Platforms and infrastructure',
  ],
  [
    'standard-api-format',
    'Standards, API et formats',
    'Standards, APIs and formats',
  ],
  ['concept-technique', 'Concepts et techniques', 'Concepts and techniques'],
  ['practice-method', 'Pratiques et méthodes', 'Practices and methods'],
  ['domain-use-case', 'Domaines et usages', 'Domains and use cases'],
]
const groups = new Map<string, WatchTopic[]>()

for (const tag of tags.sort((a, b) =>
  a.name.localeCompare(b.name, locale, { sensitivity: 'base' })
)) {
  const initial = tag.name
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .charAt(0)
    .toUpperCase()
  const letter = /^[A-Z]$/.test(initial) ? initial : '#'
  groups.set(letter, [...(groups.get(letter) ?? []), tag])
}

const sections = [...groups].sort(([a], [b]) => a.localeCompare(b, locale))
---

<BaseLayout
  locale={locale}
  title={title}
  description={
    locale === 'fr'
      ? 'Tous les tags de la veille technologique, classés par ordre alphabétique.'
      : 'Browse all tech watch tags in alphabetical order.'
  }
  canonicalPath={paths[locale]}
  alternatePaths={paths}
>
  <Header
    locale={locale}
    firstName="Sébastien"
    lastName="Rigaux"
    page="watch"
    languagePaths={paths}
  />
  <main
    id="main"
    class="mx-auto max-w-7xl px-5 pt-6 pb-20 sm:px-8 sm:pt-10 lg:px-12"
  >
    <a
      href={watchPath(locale)}
      class="inline-flex min-h-11 items-center text-sm text-accent underline-offset-4 hover:underline"
    >
      ← {locale === 'fr' ? 'Veille technologique' : 'Tech watch'}
    </a>
    <div class="mt-6 flex flex-wrap items-center justify-between gap-5">
      <h1 class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        {title}
      </h1>
      <button
        data-tag-filter-toggle
        hidden
        type="button"
        aria-expanded="false"
        aria-controls="tag-filter-panel"
        class="inline-flex min-h-11 items-center gap-2 rounded-md border border-rule px-3 text-sm text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:hidden"
      >
        <SlidersHorizontal size={16} aria-hidden="true" />
        {locale === 'fr' ? 'Filtrer' : 'Filter'}
      </button>
      <div
        id="tag-filter-panel"
        data-tag-filter
        hidden
        class="relative w-full max-w-full sm:w-auto"
      >
        <label for="tag-category" class="sr-only">
          {locale === 'fr' ? 'Catégorie' : 'Category'}
        </label>
        <select
          id="tag-category"
          class="min-h-11 max-w-full appearance-none rounded-md border border-rule bg-paper py-2 pr-10 pl-3 text-sm text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <option value="">
            {locale === 'fr' ? 'Toutes les catégories' : 'All categories'}
          </option>
          {categories
            .filter(([key]) => tags.some((tag) => tag.category === key))
            .map(([key, fr, en]) => (
              <option value={key}>{locale === 'fr' ? fr : en}</option>
            ))}
        </select>
        <ChevronDown
          size={16}
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-muted"
        />
      </div>
    </div>
    <nav
      aria-label={locale === 'fr' ? 'Index alphabétique' : 'Alphabetical index'}
      class="mt-7 flex flex-wrap gap-x-1 border-b border-rule pb-6"
    >
      {sections.map(([letter]) => (
        <a
          data-letter-link
          href={`#tag-${letter === '#' ? 'other' : letter}`}
          class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm text-muted underline-offset-4 hover:text-accent hover:underline focus-visible:outline-2 focus-visible:outline-accent"
        >
          {letter}
        </a>
      ))}
    </nav>
    <div
      data-tag-directory
      class="mt-10 columns-1 gap-12 sm:columns-2 lg:columns-3 xl:columns-4"
    >
      {sections.map(([letter, items]) => (
        <section
          id={`tag-${letter === '#' ? 'other' : letter}`}
          class="mb-10 scroll-mt-24 break-inside-avoid"
          aria-labelledby={`heading-${letter}`}
        >
          <h2
            id={`heading-${letter}`}
            class="sticky top-16 z-10 mb-3 border-b border-rule bg-paper py-3 font-display text-2xl font-semibold text-accent sm:top-[65px]"
          >
            {letter}
          </h2>
          <ul class="space-y-1">
            {items.map((tag) => (
              <li
                data-tag-category={tag.category ?? ''}
                class:list={[tag.highlighted && 'font-semibold']}
              >
                {tag.path ? (
                  <a
                    href={tag.path}
                    class="inline-flex min-h-11 items-center text-ink underline-offset-4 hover:text-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                  >
                    {tag.name}
                  </a>
                ) : (
                  <span class="inline-flex min-h-11 items-center text-muted">
                    {tag.name}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <footer class="border-t border-rule">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-6 text-sm text-muted sm:px-8 lg:px-12">
      <span>Sébastien Rigaux</span>
      <CookieSettings locale={locale} />
    </div>
  </footer>
</BaseLayout>

<script>
  function initTagFilter() {
    const filter = document.querySelector<HTMLElement>('[data-tag-filter]')
    const select = document.querySelector<HTMLSelectElement>('#tag-category')
    const directory = document.querySelector<HTMLElement>(
      '[data-tag-directory]'
    )
    if (!filter || !select || !directory) return
    filter.hidden = false
    const toggle = document.querySelector<HTMLButtonElement>(
      '[data-tag-filter-toggle]'
    )
    if (toggle) {
      toggle.hidden = false
      toggle.onclick = () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true'
        toggle.setAttribute('aria-expanded', String(open))
        filter.dataset.open = String(open)
        if (open) select.focus()
      }
    }
    const update = () => {
      directory
        .querySelectorAll<HTMLElement>('[data-tag-category]')
        .forEach((item) => {
          item.hidden = Boolean(
            select.value && item.dataset.tagCategory !== select.value
          )
        })
      directory.querySelectorAll<HTMLElement>('section').forEach((section) => {
        section.hidden = !section.querySelector(
          '[data-tag-category]:not([hidden])'
        )
        document
          .querySelectorAll<HTMLAnchorElement>('[data-letter-link]')
          .forEach((link) => {
            if (link.hash === `#${section.id}`) {
              link.setAttribute('aria-disabled', String(section.hidden))
              link.tabIndex = section.hidden ? -1 : 0
              link.onclick = (event) => {
                if (link.getAttribute('aria-disabled') === 'true')
                  event.preventDefault()
              }
            }
          })
      })
    }
    select.onchange = update
    update()
  }
  initTagFilter()
  document.addEventListener('astro:page-load', initTagFilter)
</script>

<style>
  @media (width < 40rem) {
    [data-tag-filter]:not([data-open='true']) {
      display: none;
    }
    [data-tag-filter] select {
      width: 100%;
    }
  }
  [data-letter-link][aria-disabled='true'] {
    opacity: 0.18;
    pointer-events: none;
  }
  [hidden] {
    display: none !important;
  }
  @supports (display: grid-lanes) {
    [data-tag-directory] {
      --tag-columns: 1;
      display: grid-lanes;
      columns: auto;
      grid-template-columns: repeat(var(--tag-columns), minmax(0, 1fr));
      gap: 2.5rem 3rem;
    }

    [data-tag-directory] > section {
      margin-bottom: 0;
    }

    @media (min-width: 40rem) {
      [data-tag-directory] {
        --tag-columns: 2;
      }
    }

    @media (min-width: 64rem) {
      [data-tag-directory] {
        --tag-columns: 3;
      }
    }

    @media (min-width: 80rem) {
      [data-tag-directory] {
        --tag-columns: 4;
      }
    }
  }
</style>
