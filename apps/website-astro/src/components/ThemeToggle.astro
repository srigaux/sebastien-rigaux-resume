---
import { Moon, Sun } from "@lucide/astro";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  fr: { toLight: "Passer en mode clair", toDark: "Passer en mode sombre" },
  en: { toLight: "Switch to light mode", toDark: "Switch to dark mode" },
}[locale];
---

<button
  type="button"
  data-theme-toggle
  data-label-to-light={copy.toLight}
  data-label-to-dark={copy.toDark}
  aria-label={copy.toDark}
  title={copy.toDark}
  class="min-h-11 min-w-11 items-center justify-center rounded-sm text-ink transition-colors hover:bg-ink/5"
>
  <Sun data-theme-icon-light class="size-5" aria-hidden="true" />
  <Moon data-theme-icon-dark class="size-5" aria-hidden="true" />
</button>
