---
import CookieSettings from "@/components/CookieSettings.astro";
import About from "@/components/About.astro";
import Education from "@/components/Education.astro";
import Experience from "@/components/Experience.astro";
import Header from "@/components/Header.astro";
import Skills from "@/components/Skills.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale, Person } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const person: Person = {
  firstName: "Sébastien",
  lastName: "Rigaux",
  role: {
    fr: "Architecture logicielle · Leadership technique · Produits web et mobiles",
    en: "Software architecture · Engineering leadership · Web and mobile products",
  },
  jobTitle: {
    fr: "Directeur technique (CTO) · Tech Lead",
    en: "CTO · Tech Lead",
  },
  firstExperienceDate: "2012-02-01",
  email: "sebastien@rigaux.be",
  phone: "+32 476 42 08 48",
  website: "https://sebastien.rigaux.be",
  address: {
    formatted: { fr: "Visé, Belgique", en: "Visé, Belgium" },
    zip: "4600",
    locality: "Visé",
    country: "Belgium",
  },
  socialLinks: [
    {
      label: "Github",
      identifier: "/ srigaux",
      url: "https://github.com/srigaux",
    },
    {
      label: "Facebook",
      identifier: "/ srigaux",
      url: "https://facebook.com/srigaux",
    },
    {
      label: "Linkedin",
      identifier: "/ sebastien-rigaux",
      url: "https://linkedin.com/in/sebastien-rigaux",
    },
    {
      label: "Twitter",
      identifier: "/ rigauxse",
      url: "https://twitter.com/rigauxse",
    },
    {
      label: "Instagram",
      identifier: "/ rigauxse",
      url: "https://www.instagram.com/rigauxse/",
    },
  ],
};
const copy = {
  fr: {
    title: "Directeur technique (CTO) et Tech Lead près de Liège",
    description:
      "Sébastien Rigaux, CTO et Tech Lead basé près de Liège. Architecture logicielle, produits web et mobiles, transition IA et CTO as a Service.",
    backToTop: "Retour en haut",
    resourcesLabel: "Formats du CV et fichiers pour les LLM",
    pdfFooterLabel: "CV en français au format PDF",
    markdownFooterLabel: "Version Markdown de cette page",
    markdownFooterText: "Markdown",
  },
  en: {
    title: "CTO and Tech Lead in Belgium",
    description:
      "Sébastien Rigaux is a CTO and Tech Lead near Liège, Belgium. Software architecture, web and mobile products, AI transition and CTO as a Service.",
    backToTop: "Back to top",
    resourcesLabel: "Résumé formats and LLM files",
    pdfFooterLabel: "English résumé as PDF",
    markdownFooterLabel: "Markdown version of this page",
    markdownFooterText: "Markdown",
  },
}[locale];
const name = `${person.firstName} ${person.lastName}`;
const footerLinkClass = "text-muted underline-offset-4 hover:text-accent hover:underline focus-visible:text-accent focus-visible:underline";
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  person={person}
>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      root.classList.add("brand-ready");
      window.addEventListener(
        "load",
        () => {
          if (!root.hasAttribute("data-brand-observing"))
            root.classList.remove("brand-ready");
        },
        { once: true },
      );
    })();
  </script>
  <Header
    locale={locale}
    firstName={person.firstName}
    lastName={person.lastName}
  />
  <main data-cv class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <About locale={locale} person={person} />
    <Experience locale={locale} />
    <Education locale={locale} />
    <Skills locale={locale} />
  </main>
  <footer class="border-t border-rule">
    <div
      class="mx-auto grid max-w-7xl grid-cols-2 items-center gap-x-4 gap-y-5 px-5 py-8 text-sm text-muted sm:px-8 md:grid-cols-[1fr_auto_1fr] lg:px-12"
    >
      <p class="col-start-1 row-start-1">{name}</p>
      <nav
        aria-label={copy.resourcesLabel}
        class="col-span-2 row-start-2 justify-self-center md:col-span-1 md:col-start-2 md:row-start-1"
      >
        <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs">
          <li>
            <a
              href={`/pdf/Sebastien-Rigaux-CV-${locale.toUpperCase()}.pdf`}
              aria-label={copy.pdfFooterLabel}
              type="application/pdf"
              class={footerLinkClass}>PDF</a
            >
          </li>
          <li>
            <a
              href={`/${locale}.md`}
              aria-label={copy.markdownFooterLabel}
              type="text/markdown"
              class={footerLinkClass}>{copy.markdownFooterText}</a
            >
          </li>
          <li><CookieSettings locale={locale} /></li>
          <li><a href="/llms.txt" class={footerLinkClass}>llms.txt</a></li>
          <li><a href="/llms-full.txt" class={footerLinkClass}>llms-full.txt</a></li>
        </ul>
      </nav>
      <a
        href="#about"
        class="col-start-2 row-start-1 justify-self-end font-medium text-accent hover:underline md:col-start-3"
        >{copy.backToTop}</a
      >
    </div>
  </footer>

</BaseLayout>
