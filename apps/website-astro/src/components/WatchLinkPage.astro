---
import CookieSettings from "@/components/CookieSettings.astro";
import { pageMarkdownPath } from "@/lib/urls";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import { watchLinkPath, watchLinkTarget, watchPath, type WatchLink } from "@/lib/watch-model";
import { renderSummaryMarkdown, summaryText } from "@/lib/watch-markdown";
import type { Locale } from "@/types";

interface Props { locale: Locale; link: WatchLink; previousLink?: WatchLink; nextLink?: WatchLink }
const { locale, link, previousLink, nextLink } = Astro.props;
const t = locale === "fr" ? {
  markdown: "Version Markdown de cette page", watch: "Veille technologique", original: "Consulter la ressource originale", selected: "Sélectionné le",
  published: "Publication de la ressource", updated: "Mise à jour de la fiche", credit: "Crédit",
  discovered: "Repéré via", topics: "Sujets", back: "Retour à la veille", sourceLanguage: "Langue de la source",
  navigation: "Parcourir les liens de la veille", previous: "Lien précédent", next: "Lien suivant",
} : {
  markdown: "Markdown version of this page", watch: "Tech watch", original: "Open the original resource", selected: "Selected on",
  published: "Resource publication", updated: "Entry updated", credit: "Credit",
  discovered: "Found via", topics: "Topics", back: "Back to tech watch", sourceLanguage: "Source language",
  navigation: "Browse tech watch links", previous: "Previous link", next: "Next link",
};
const path = watchLinkPath(locale, link.uid);
const languagePaths = { fr: watchLinkTarget(link, "fr"), en: watchLinkTarget(link, "en") };
const site = Astro.site!;
const canonical = new URL(path, site).href;
const description = summaryText(link.summary);
const formatter = new Intl.DateTimeFormat(locale === "fr" ? "fr-BE" : "en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const date = (value: string) => formatter.format(new Date(value.length === 10 ? `${value}T00:00:00Z` : value));
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical, name: link.title, description,
      inLanguage: locale, datePublished: link.firstPublishedAt, dateModified: link.updatedAt,
      isPartOf: { "@id": new URL("/#website", site).href },
      breadcrumb: { "@id": `${canonical}#breadcrumb` },
      relatedLink: link.url,
      ...(link.image && { image: link.image.url }),
    },
    {
      "@type": "BreadcrumbList", "@id": `${canonical}#breadcrumb`, itemListElement: [
        { "@type": "ListItem", position: 1, name: t.watch, item: new URL(watchPath(locale), site).href },
        { "@type": "ListItem", position: 2, name: link.title, item: canonical },
      ],
    },
  ],
};
---
<BaseLayout locale={locale} title={link.title} description={description} canonicalPath={path} alternatePaths={link.alternatePaths} markdownPath={pageMarkdownPath(path)} modifiedAt={link.updatedAt} socialImage={link.image} previousPath={previousLink && watchLinkTarget(previousLink, locale)} nextPath={nextLink && watchLinkTarget(nextLink, locale)}>
  <Header locale={locale} firstName="Sébastien" lastName="Rigaux" page="watch" languagePaths={languagePaths} />
  <main id="main" class="mx-auto max-w-7xl px-5 pb-24 pt-12 sm:px-8 sm:pt-16 lg:px-12 lg:pt-20">
    <nav no-intersect aria-label={locale === "fr" ? "Fil d’Ariane" : "Breadcrumb"} class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mb-10 text-sm text-muted">
      <a href={watchPath(locale)} class="inline-flex min-h-11 items-center text-accent underline-offset-4 hover:underline">← {t.back}</a>
    </nav>
    <article class="max-w-4xl">
      <div aria-hidden="true" class="mb-8 h-0.5 w-20 -rotate-12 bg-accent"></div>
      <p no-intersect class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mb-4 text-base font-semibold text-accent">{t.watch} · {link.format}</p>
      <h1 no-intersect class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none break-words font-display text-[clamp(2.25rem,5vw,4.5rem)] font-bold leading-[1.12] tracking-[-0.035em] text-ink">{link.title}</h1>
      <div no-intersect class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
        <span>{t.selected} <time datetime={link.selectedOn}>{date(link.selectedOn)}</time></span>
        {link.sourceLanguage && <span>{t.sourceLanguage} : {link.sourceLanguage}</span>}
      </div>
      <div no-intersect class="[&_p+p]:mt-3 intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-9 max-w-[72ch] text-lg leading-[1.8] text-muted sm:text-xl [&_a]:break-words [&_a]:underline [&_a:hover]:text-accent [&_strong]:font-semibold [&_em]:italic [&_code]:rounded [&_code]:bg-ink/5 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.9em]" set:html={renderSummaryMarkdown(link.summary)} />
      {link.image && <figure no-intersect class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-9"><img src={link.image.url} alt={link.image.alt} width={link.image.width} height={link.image.height} loading="lazy" class="h-auto max-h-[32rem] w-full object-contain" /></figure>}
      <a no-intersect href={link.url} target="_blank" rel="noopener noreferrer" class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-9 inline-flex min-h-11 items-center gap-2 border border-accent px-5 py-3 text-base font-semibold text-accent underline-offset-4 hover:bg-accent/10 hover:underline">{t.original} <span aria-hidden="true">↗</span></a>
      <p no-intersect class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-3 break-all text-sm text-muted">{new URL(link.url).hostname}</p>
      <dl no-intersect class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-10 grid gap-4 border-t border-rule pt-8 text-sm text-muted sm:grid-cols-2">
        {link.publishedOn && <div><dt class="font-semibold text-ink">{t.published}</dt><dd class="mt-1"><time datetime={link.publishedOn}>{date(link.publishedOn)}</time></dd></div>}
        <div><dt class="font-semibold text-ink">{t.updated}</dt><dd class="mt-1"><time datetime={link.updatedAt}>{date(link.updatedAt)}</time></dd></div>
        {link.credit && <div><dt class="font-semibold text-ink">{t.credit}</dt><dd class="mt-1">{link.credit}</dd></div>}
        {link.discoveredVia && <div><dt class="font-semibold text-ink">{t.discovered}</dt><dd class="mt-1"><a href={link.discoveredVia.url} target="_blank" rel="noopener noreferrer" class="underline decoration-rule hover:text-accent">{link.discoveredVia.name}</a></dd></div>}
      </dl>
      <section no-intersect class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-9" aria-label={t.topics}>
        <h2 class="text-sm font-semibold text-ink">{t.topics}</h2>
        <div class="mt-3 flex flex-wrap gap-2">{link.topics.map((topic) => <a href={watchPath(locale, 1, topic.uid)} class="inline-flex min-h-11 items-center border border-rule px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent">{topic.name}</a>)}</div>
      </section>
      {(previousLink || nextLink) && <nav no-intersect aria-label={t.navigation} class="intersect:motion-preset-blur-up motion-duration-500 intersect-once intersect-[0.2] motion-reduce:animate-none mt-12 grid gap-6 border-t border-rule pt-8 sm:grid-cols-2 sm:gap-10">
        {previousLink && <a href={watchLinkTarget(previousLink, locale)} rel="prev" class="group min-w-0 py-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
          <span class="block text-sm text-muted"><span aria-hidden="true">← </span>{t.previous}</span>
          <span class="mt-2 block break-words text-base font-semibold leading-relaxed text-ink group-hover:text-accent group-hover:underline">{previousLink.title}</span>
        </a>}
        {nextLink && <a href={watchLinkTarget(nextLink, locale)} rel="next" class="group min-w-0 py-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:col-start-2 sm:text-right">
          <span class="block text-sm text-muted">{t.next}<span aria-hidden="true"> →</span></span>
          <span class="mt-2 block break-words text-base font-semibold leading-relaxed text-ink group-hover:text-accent group-hover:underline">{nextLink.title}</span>
        </a>}
      </nav>}
    </article>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  </main>
  <footer class="border-t border-rule">
    <div class="mx-auto grid max-w-7xl grid-cols-2 items-center gap-x-4 gap-y-5 px-5 py-8 text-sm text-muted sm:px-8 md:grid-cols-[1fr_auto_1fr] lg:px-12">
      <p class="col-start-1 row-start-1">Sébastien Rigaux</p>
      <a
        href={pageMarkdownPath(path)}
        aria-label={t.markdown}
        type="text/markdown"
        class="col-span-2 row-start-2 justify-self-center text-xs text-muted underline-offset-4 hover:text-accent hover:underline focus-visible:text-accent focus-visible:underline md:col-span-1 md:col-start-2 md:row-start-1"
      >Markdown</a>
      <a href={watchPath(locale)} class="col-start-2 row-start-1 justify-self-end text-accent hover:underline md:col-start-3">{t.back}</a>
    </div>
    <div class="mx-auto max-w-7xl px-5 pb-6 text-center sm:px-8 lg:px-12"><CookieSettings locale={locale} /></div>
  </footer>
</BaseLayout>
