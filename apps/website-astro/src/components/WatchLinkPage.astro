---
import {
  ArrowUpRight,
  FileText,
  Video,
  GitFork,
  Rocket,
  BookOpen,
  Wrench,
  Ellipsis,
} from '@lucide/astro'
import WatchSiteIcon from '@/components/WatchSiteIcon.astro'
import WatchImage from '@/components/WatchImage.astro'
import WatchFooter from '@/components/WatchFooter.astro'
import { pageMarkdownPath } from '@/lib/urls'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/Header.astro'
import {
  watchLinkPath,
  watchLinkTarget,
  watchPath,
  type WatchLink,
} from '@/lib/watch-model'
import { renderSummaryMarkdown, summaryText } from '@/lib/watch-markdown'
import type { Locale } from '@/types'

interface Props {
  locale: Locale
  link: WatchLink
  previousLink?: WatchLink
  nextLink?: WatchLink
}
const { locale, link, previousLink, nextLink } = Astro.props
const t =
  locale === 'fr'
    ? {
        markdown: 'Version Markdown de cette page',
        watch: 'Veille technologique',
        original: 'Consulter la ressource',
        selected: 'Sélectionné le',
        published: 'Publication de la ressource',
        credit: 'Crédit',
        discovered: 'Repéré via',
        format: 'Format',
        topics: 'Tags',
        sourceLanguage: 'Langue de la source',
        navigation: 'Parcourir les liens de la veille',
        previous: 'Plus récent',
        next: 'Plus ancien',
      }
    : {
        markdown: 'Markdown version of this page',
        watch: 'Tech watch',
        original: 'View resource',
        selected: 'Selected on',
        published: 'Resource publication',
        credit: 'Credit',
        discovered: 'Found via',
        format: 'Format',
        topics: 'Tags',
        sourceLanguage: 'Source language',
        navigation: 'Browse tech watch links',
        previous: 'Newer',
        next: 'Older',
      }
const FormatIcon = {
  Article: FileText,
  Video,
  Repository: GitFork,
  Release: Rocket,
  Documentation: BookOpen,
  Tool: Wrench,
  Other: Ellipsis,
}[link.format]
const path = watchLinkPath(locale, link.uid)
const languagePaths = {
  fr: watchLinkTarget(link, 'fr'),
  en: watchLinkTarget(link, 'en'),
}
const site = Astro.site!
const canonical = new URL(path, site).href
const description = summaryText(link.summary)
const formatter = new Intl.DateTimeFormat(locale === 'fr' ? 'fr-BE' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
const date = (value: string) =>
  formatter.format(new Date(value.length === 10 ? `${value}T00:00:00Z` : value))
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: link.title,
      description,
      inLanguage: locale,
      datePublished: link.firstPublishedAt,
      dateModified: link.updatedAt,
      isPartOf: { '@id': new URL('/#website', site).href },
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      relatedLink: link.url,
      keywords: link.topics.map((tag) => tag.name),
      ...(link.image && { image: link.image.url }),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t.watch,
          item: new URL(watchPath(locale), site).href,
        },
        { '@type': 'ListItem', position: 2, name: link.title, item: canonical },
      ],
    },
  ],
}
---

<BaseLayout
  keywords={link.topics.map((tag) => tag.name)}
  locale={locale}
  title={link.title}
  description={description}
  canonicalPath={path}
  alternatePaths={link.alternatePaths}
  markdownPath={pageMarkdownPath(path)}
  modifiedAt={link.updatedAt}
  socialImage={link.image}
  previousPath={previousLink && watchLinkTarget(previousLink, locale)}
  nextPath={nextLink && watchLinkTarget(nextLink, locale)}
>
  <Header
    locale={locale}
    firstName="Sébastien"
    lastName="Rigaux"
    page="watch"
    languagePaths={languagePaths}
  />
  <main
    id="main"
    class="mx-auto max-w-7xl px-5 pt-6 pb-20 sm:px-8 sm:pt-10 lg:px-12 lg:pt-12"
  >
    <nav
      no-intersect
      aria-label={locale === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}
      class="intersect-[0.2] intersect-once mb-6 text-sm text-muted motion-duration-500 motion-reduce:animate-none intersect:motion-preset-blur-up"
    >
      <a
        href={watchPath(locale)}
        class="inline-flex min-h-11 items-center text-accent underline-offset-4 hover:underline"
      >
        ← {t.watch}
      </a>
    </nav>
    <article>
      <h1
        no-intersect
        class="intersect-[0.2] intersect-once font-display text-[clamp(2rem,4.5vw,3.75rem)] leading-[1.15] font-bold tracking-[-0.035em] text-balance wrap-break-word text-ink motion-delay-80 motion-duration-500 motion-reduce:animate-none intersect:motion-preset-blur-up"
      >
        {link.title}
      </h1>
      <section
        no-intersect
        class="intersect-[0.2] intersect-once mt-5 motion-delay-160 motion-duration-500 motion-reduce:animate-none intersect:motion-preset-blur-up"
        aria-label={t.topics}
      >
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="mr-2 inline-flex items-center gap-1.5 py-1.5 text-xs text-muted"
            aria-label={`${t.format} : ${link.format}`}
          >
            <FormatIcon size={14} class="shrink-0" aria-hidden="true" />
            {link.format}
          </span>
          {link.topics.map((topic) => (
            <a
              href={topic.path ?? undefined}
              class="rounded-md bg-ink/5 px-2.5 py-1.5 text-xs text-muted no-underline transition-colors hover:bg-accent/10 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              {topic.name}
            </a>
          ))}
        </div>
      </section>
      <a
        no-intersect
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${t.original} — ${new URL(link.url).hostname}${link.sourceLanguage && link.sourceLanguage.toLowerCase() !== locale ? ` — ${t.sourceLanguage} : ${link.sourceLanguage}` : ''}`}
        class="group intersect-[0.2] intersect-once mt-7 flex flex-wrap items-center gap-x-6 gap-y-4 py-2 no-underline motion-delay-200 motion-duration-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:animate-none intersect:motion-preset-blur-up"
      >
        <span class="inline-flex min-h-11 shrink-0 items-center gap-2 border border-accent bg-accent px-4 py-2 text-sm font-semibold text-paper no-underline transition-[background-color,transform] duration-200 group-hover:bg-ink group-focus-visible:bg-ink group-active:scale-[0.98] motion-reduce:transition-none motion-reduce:group-active:scale-100">
          {t.original}
          {link.sourceLanguage &&
            link.sourceLanguage.toLowerCase() !== locale && (
              <span
                class="border border-current/40 px-1.5 py-0.5 text-xs font-semibold tracking-wide"
                title={`${t.sourceLanguage} : ${link.sourceLanguage}`}
              >
                {link.sourceLanguage}
              </span>
            )}
          <ArrowUpRight class="size-4" aria-hidden="true" />
        </span>
        <p class="inline-flex max-w-full min-w-0 items-center text-sm text-muted [&_img]:shrink-0 [&_picture]:shrink-0">
          <WatchSiteIcon
            icon={link.siteIcon}
            fallbackIcon={link.discoveredVia?.icon}
            monogram={new URL(link.url).hostname
              .replace(/^www\./, '')
              .charAt(0)
              .toUpperCase()}
            eager
          />
          <span class="min-w-0 wrap-anywhere underline-offset-4 group-hover:underline group-focus-visible:underline">
            {new URL(link.url).hostname}
          </span>
        </p>
      </a>
      <div class="mt-9 grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
        <div class="min-w-0">
          <div
            no-intersect
            class="intersect-[0.2] intersect-once text-base leading-[1.8] text-ink motion-delay-240 motion-duration-500 motion-reduce:animate-none sm:text-lg intersect:motion-preset-blur-up [&_a]:wrap-break-word [&_a]:underline [&_a:hover]:text-accent [&_code]:rounded-sm [&_code]:bg-ink/5 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.9em] [&_em]:italic [&_p+p]:mt-3 [&_strong]:font-semibold"
            set:html={renderSummaryMarkdown(link.summary)}
          />
          {link.image && (
            <WatchImage
              image={link.image}
              detail
              class="h-auto max-h-128 w-full object-contain"
            />
          )}
        </div>
        <aside
          aria-label={
            locale === 'fr' ? 'À propos de la ressource' : 'About this resource'
          }
          class="min-w-0 lg:pt-1"
        >
          <dl
            no-intersect
            class="intersect-[0.2] intersect-once grid gap-6 text-sm text-muted motion-duration-500 motion-reduce:animate-none sm:grid-cols-3 lg:grid-cols-1 intersect:motion-preset-blur-up"
          >
            <div>
              <dt class="font-semibold text-ink">{t.selected}</dt>
              <dd class="mt-1">
                <time datetime={link.selectedOn}>{date(link.selectedOn)}</time>
              </dd>
            </div>
            {link.publishedOn && (
              <div>
                <>
                  <dt class="font-semibold text-ink">{t.published}</dt>
                  <dd class="mt-1">
                    <time datetime={link.publishedOn}>
                      {date(link.publishedOn)}
                    </time>
                  </dd>
                </>
              </div>
            )}
            {link.credit && (
              <div>
                <>
                  <dt class="font-semibold text-ink">{t.credit}</dt>
                  <dd class="mt-1">{link.credit}</dd>
                </>
              </div>
            )}
            {link.discoveredVia && (
              <div>
                <>
                  <dt class="font-semibold text-ink">{t.discovered}</dt>
                  <dd class="mt-1">
                    <a
                      href={link.discoveredVia.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-rule hover:text-accent"
                    >
                      {link.discoveredVia.name}
                    </a>
                  </dd>
                </>
              </div>
            )}
          </dl>
        </aside>
      </div>
      {(previousLink || nextLink) && (
        <nav
          no-intersect
          aria-label={t.navigation}
          class="intersect-[0.2] intersect-once mt-12 grid gap-6 border-t border-rule pt-8 motion-duration-500 motion-reduce:animate-none sm:grid-cols-2 sm:gap-10 intersect:motion-preset-blur-up"
        >
          {previousLink && (
            <a
              href={watchLinkTarget(previousLink, locale)}
              rel="prev"
              class="group min-w-0 py-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              <span class="block text-sm text-muted">
                <span aria-hidden="true">← </span>
                {t.previous}
              </span>
              <span class="mt-2 block text-base/relaxed font-semibold wrap-break-word text-ink group-hover:text-accent group-hover:underline">
                {previousLink.title}
              </span>
            </a>
          )}
          {nextLink && (
            <a
              href={watchLinkTarget(nextLink, locale)}
              rel="next"
              class="group min-w-0 py-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:col-start-2 sm:text-right"
            >
              <span class="block text-sm text-muted">
                {t.next}
                <span aria-hidden="true"> →</span>
              </span>
              <span class="mt-2 block text-base/relaxed font-semibold wrap-break-word text-ink group-hover:text-accent group-hover:underline">
                {nextLink.title}
              </span>
            </a>
          )}
        </nav>
      )}
    </article>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
  </main>
  <WatchFooter locale={locale} markdownPath={pageMarkdownPath(path)} />
</BaseLayout>
