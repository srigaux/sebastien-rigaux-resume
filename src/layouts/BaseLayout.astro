---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale, Person } from "@/types";
import "@/styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  person?: Person;
}

const { locale, title, description, noindex = false, person } = Astro.props;
const site = Astro.site ?? new URL("https://sebastien.rigaux.be");
const canonical = new URL(getRelativeLocaleUrl(locale), site).href;
const frenchUrl = new URL(getRelativeLocaleUrl("fr"), site).href;
const englishUrl = new URL(getRelativeLocaleUrl("en"), site).href;
const imageUrl = new URL("/og-image.png", site).href;
const fullTitle = `${title} | Sébastien Rigaux`;
const personId = new URL("/#person", site).href;
const profileId = `${canonical}#profile`;
const cvSchema = {
  fr: {
    occupations: [
      {
        name: "Directeur de la technologie (CTO)",
        employer: "djm digital S.A.",
        startDate: "2016",
        responsibilities: "Stratégie technologique, accompagnement des équipes, transition vers l’IA et conseil en architecture en CTO as a Service.",
      },
      {
        name: "Software Engineer II · Voicemail",
        employer: "Microsoft",
        startDate: "2020",
        endDate: "2021",
        responsibilities: "Direction de l’équipe Voicemail pour Microsoft Teams et Skype for Business, montée en charge des services et intégration de technologies vocales.",
      },
      {
        name: "Directeur de la technologie - Mobile",
        employer: "djm digital S.A.",
        startDate: "2015",
        endDate: "2016",
        responsibilities: "Direction des équipes mobile et API/backend .NET, architecture d’applications iOS et Android et intégration d’IoT en temps réel.",
      },
      {
        name: "Développeur iOS & Web",
        employer: "djm digital S.A.",
        startDate: "2012",
        endDate: "2015",
        responsibilities: "Développement d’applications iOS natives et accompagnement des projets de la conception au support client.",
      },
      {
        name: "Stage Développeur iOS",
        employer: "djm digital S.A.",
        startDate: "2012",
        endDate: "2012",
        responsibilities: "Développement d’une application iPhone, d’API et d’applications web en ASP.NET MVC.",
      },
    ],
    credentials: [
      { name: "Master en sciences informatiques, finalité gestion", level: "Master" },
      { name: "Bachelier en sciences informatiques", level: "Bachelier" },
      { name: "Bachelier en informatique de gestion", level: "Bachelier" },
    ],
    skills: [
      "Leadership technique & CTO as a Service",
      "Développement web & mobile",
      "Transition IA & automatisation",
      "Communication à grande échelle",
      "Technologies vocales & IA appliquée",
    ],
    knowsAbout: ["Évolutions de l’IA", "React", "Développement frontend", "C#", "Pratiques de tech lead", "Kubernetes"],
  },
  en: {
    occupations: [
      {
        name: "Chief Technology Officer",
        employer: "djm digital S.A.",
        startDate: "2016",
        responsibilities: "Technology strategy, team support, AI transition and architecture advice through CTO as a Service engagements.",
      },
      {
        name: "Software Engineer II · Voicemail",
        employer: "Microsoft",
        startDate: "2020",
        endDate: "2021",
        responsibilities: "Led the Voicemail team for Microsoft Teams and Skype for Business, scaled services and integrated speech technologies.",
      },
      {
        name: "Chief Technology Officer · Mobile",
        employer: "djm digital S.A.",
        startDate: "2015",
        endDate: "2016",
        responsibilities: "Led the mobile and .NET API/backend teams, architected iOS and Android applications and integrated real-time IoT.",
      },
      {
        name: "iOS & Web Developer",
        employer: "djm digital S.A.",
        startDate: "2012",
        endDate: "2015",
        responsibilities: "Built native iOS applications and supported projects from planning through launch and client support.",
      },
      {
        name: "iOS Developer Intern",
        employer: "djm digital S.A.",
        startDate: "2012",
        endDate: "2012",
        responsibilities: "Developed an iPhone app, APIs and web applications using ASP.NET MVC.",
      },
    ],
    credentials: [
      { name: "Master of Science in Computer Science, Management track", level: "Master" },
      { name: "Bachelor of Science in Computer Science", level: "Bachelor" },
      { name: "Bachelor in Management Computing", level: "Bachelor" },
    ],
    skills: [
      "Technical leadership & CTO as a Service",
      "Web & mobile engineering",
      "AI transition & automation",
      "Communication at scale",
      "Speech technology & applied AI",
    ],
    knowsAbout: ["AI developments", "React", "Frontend development", "C#", "Engineering leadership", "Kubernetes"],
  },
}[locale];
const structuredData = person && JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": profileId,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: locale,
      mainEntity: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: `${person.firstName} ${person.lastName}`,
      givenName: person.firstName,
      familyName: person.lastName,
      description,
      jobTitle: person.jobTitle[locale],
      url: canonical,
      email: person.email,
      telephone: person.phone,
      address: {
        "@type": "PostalAddress",
        addressCountry: person.address.country,
        addressLocality: person.address.locality,
        postalCode: person.address.zip,
      },
      worksFor: {
        "@type": "Organization",
        name: "djm digital S.A.",
        url: "https://djmdigital.be/fr/",
      },
      hasOccupation: cvSchema.occupations.map(({ name, employer, startDate, responsibilities, ...dates }) => ({
        "@type": "Role",
        roleName: name,
        description: `${name} · ${employer}`,
        startDate,
        ...dates,
        hasOccupation: {
          "@type": "Occupation",
          name,
          responsibilities,
        },
      })),
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "HEC Liège", url: "https://www.hec.uliege.be/" },
        { "@type": "CollegeOrUniversity", name: "Université de Liège", url: "https://www.fsa.uliege.be/cms/c_3112656/fr/fsa" },
        { "@type": "CollegeOrUniversity", name: "Haute École de la Province de Liège", url: "https://www.hepl.be/fr/informatique" },
      ],
      hasCredential: cvSchema.credentials.map(({ name, level }) => ({
        "@type": "EducationalOccupationalCredential",
        name,
        credentialCategory: "degree",
        educationalLevel: level,
      })),
      knowsLanguage: ["fr", "en", "nl"],
      skills: cvSchema.skills,
      knowsAbout: cvSchema.knowsAbout,
      sameAs: person.socialLinks.map((link) => link.url),
    },
  ],
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f8f7" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const system = window.matchMedia("(prefers-color-scheme: dark)");
        let preference = "system";

        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") preference = saved;
        } catch {
          // The system setting remains available when storage is blocked.
        }

        const apply = () => {
          const dark = preference === "dark" || (preference === "system" && system.matches);
          root.classList.toggle("dark", dark);
          root.classList.toggle("light", !dark);
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#111c1a" : "#f6f8f7");

          const toggle = document.querySelector("[data-theme-toggle]");
          const label = toggle?.getAttribute(dark ? "data-label-to-light" : "data-label-to-dark");
          if (toggle && label) {
            toggle.setAttribute("aria-label", label);
            toggle.setAttribute("title", label);
          }
        };

        apply();
        document.addEventListener("DOMContentLoaded", apply, { once: true });
        system.addEventListener("change", () => {
          if (preference === "system") apply();
        });
        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) return;
          preference = root.classList.contains("dark") ? "light" : "dark";
          try {
            localStorage.setItem("theme", preference);
          } catch {
            // The preference still applies to the current page.
          }
          apply();
        });
      })();
    </script>
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-sora" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="fr" href={frenchUrl} />
        <link rel="alternate" hreflang="en" href={englishUrl} />
        <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
        <meta property="og:type" content="profile" />
        <meta property="og:locale" content={locale === "fr" ? "fr_BE" : "en_US"} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:alt" content={locale === "fr" ? "Monogramme SR de Sébastien Rigaux" : "Sébastien Rigaux’s SR monogram"} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:creator" content="@rigauxse" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        {structuredData && <script type="application/ld+json" set:html={structuredData} />}
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
