---
import { getRelativeLocaleUrl } from "astro:i18n";
import { EllipsisVertical } from "@lucide/astro";
import Logo from "@/assets/logo.svg";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
  firstName: string;
  lastName: string;
}

const { locale, firstName, lastName } = Astro.props;
const nav = {
  fr: {
    about: "À propos",
    experience: "Expérience",
    education: "Études",
    skills: "Compétences",
    menu: "Menu",
  },
  en: {
    about: "About",
    experience: "Experience",
    education: "Education",
    skills: "Skills",
    menu: "Menu",
  },
}[locale];
const sections = [
  { id: "about", label: nav.about },
  { id: "experience", label: nav.experience },
  { id: "education", label: nav.education },
  { id: "skills", label: nav.skills },
];
const navigationLabel = locale === "fr" ? "Navigation principale" : "Main navigation";
const languageLabel = locale === "fr" ? "Choisir la langue" : "Choose language";
---

<header class="sticky top-0 z-50 border-b border-transparent bg-paper/95 backdrop-blur-md data-[scrolled]:border-rule motion-safe:transition-colors">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8 lg:px-12">
    <a
      data-header-brand
      href="#about"
      class="group flex shrink-0 items-center gap-3 rounded-sm text-ink no-underline"
      aria-label={`${firstName} ${lastName} — ${nav.about}`}
    >
      <Logo data-header-brand-logo class="size-10 text-accent" aria-hidden="true" />
      <span class="hidden font-display text-sm font-bold tracking-[-0.03em] sm:inline">
        {firstName} <span class="text-accent">{lastName}</span>
      </span>
    </a>

    <nav aria-label={navigationLabel} class="hidden items-center gap-6 lg:flex">
      {sections.map(({ id, label }) => (
        <a
          href={`#${id}`}
          class="relative text-sm font-medium text-muted no-underline transition-colors hover:text-accent focus-visible:text-accent before:pointer-events-none before:absolute before:inset-x-0 before:bottom-0 before:h-[max(1px,0.05em)] before:origin-right before:scale-x-0 before:bg-current before:content-[''] before:transition-transform before:duration-300 before:ease-[cubic-bezier(0.23,1,0.32,1)] hover:before:origin-left hover:before:scale-x-100 focus-visible:before:origin-left focus-visible:before:scale-x-100 motion-reduce:before:transition-none"
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <nav aria-label={languageLabel} class="flex items-center gap-1 text-sm font-semibold">
        <a
          data-locale-link
          href={getRelativeLocaleUrl("fr")}
          lang="fr"
          hreflang="fr"
          aria-current={locale === "fr" ? "page" : undefined}
          class:list={[
            "rounded-sm px-2 py-1 transition-colors hover:text-accent",
            locale === "fr" ? "text-accent underline decoration-2" : "text-muted",
          ]}
        >FR</a>
        <span aria-hidden="true" class="text-rule">/</span>
        <a
          data-locale-link
          href={getRelativeLocaleUrl("en")}
          lang="en"
          hreflang="en"
          aria-current={locale === "en" ? "page" : undefined}
          class:list={[
            "rounded-sm px-2 py-1 transition-colors hover:text-accent",
            locale === "en" ? "text-accent underline decoration-2" : "text-muted",
          ]}
        >EN</a>
      </nav>

      <ThemeToggle locale={locale} />

      <details id="mobile-menu" class="group relative lg:hidden">
        <summary title={nav.menu} class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-sm border border-rule text-ink transition-colors hover:border-accent hover:bg-ink/5 dark:hover:bg-ink/10 marker:hidden">
          <EllipsisVertical class="size-5" aria-hidden="true" />
          <span class="sr-only">{nav.menu}</span>
        </summary>
        <nav
          aria-label={navigationLabel}
          class="absolute right-0 top-[calc(100%+0.75rem)] w-56 border border-rule bg-paper p-2 shadow-lg shadow-ink/10"
        >
          {sections.map(({ id, label }) => (
            <a href={`#${id}`} class="block rounded-sm px-3 py-3 text-sm font-medium text-ink hover:bg-ink/5 hover:text-accent dark:hover:bg-ink/10">
              {label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>("header");
  const heroLogo = document.querySelector<SVGElement>("[data-hero-logo]");
  const heroTitle = document.querySelector<HTMLElement>("#name");
  const desktop = window.matchMedia("(min-width: 64rem)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (header && heroLogo && heroTitle) {
    let brandVisible = false;
    let transition: ViewTransition | undefined;
    let frame = 0;
    const apply = () => root.classList.toggle("brand-visible", brandVisible);

    const syncBrand = (animate = true) => {
      header.toggleAttribute("data-scrolled", window.scrollY > 0);
      const reference = desktop.matches ? heroLogo : heroTitle;
      const rect = reference.getBoundingClientRect();
      const headerBottom = header.getBoundingClientRect().bottom;
      const nextVisible = rect.top <= headerBottom;
      if (nextVisible === brandVisible) return;

      brandVisible = nextVisible;
      if (transition) {
        transition.skipTransition();
        apply();
        return;
      }

      const logoIsVisible = rect.bottom > headerBottom && rect.top < window.innerHeight;
      if (animate && desktop.matches && !reducedMotion.matches && logoIsVisible && document.startViewTransition) {
        transition = document.startViewTransition(apply);
        transition.finished.then(() => {
          transition = undefined;
          apply();
        });
      } else {
        apply();
      }
    };

    const scheduleBrandSync = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        syncBrand();
      });
    };

    syncBrand(false);
    root.dataset.brandObserving = "";
    window.addEventListener("scroll", scheduleBrandSync, { passive: true });
    window.addEventListener("resize", scheduleBrandSync);
  }

  const updateLanguageLinks = () => {
    document.querySelectorAll<HTMLAnchorElement>("[data-locale-link]").forEach((link) => {
      const url = new URL(link.href);
      url.hash = window.location.hash;
      link.href = url.href;
    });
  };

  updateLanguageLinks();
  window.addEventListener("hashchange", updateLanguageLinks);

  const menu = document.querySelector<HTMLDetailsElement>("#mobile-menu");
  const themeSwitcher = document.querySelector<HTMLDetailsElement>("[data-theme-switcher]");
  menu?.addEventListener("toggle", () => {
    if (menu.open && themeSwitcher) themeSwitcher.open = false;
  });
  themeSwitcher?.addEventListener("toggle", () => {
    if (themeSwitcher.open && menu) menu.open = false;
  });
  menu?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
    });
  });
</script>
