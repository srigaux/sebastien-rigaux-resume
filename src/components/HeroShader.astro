<div
  class="hero-shader group pointer-events-none absolute inset-x-[calc(50%-50vw)] -top-32 -bottom-8 z-[-1] overflow-hidden bg-[radial-gradient(ellipse_35%_50%_at_76%_48%,color-mix(in_srgb,var(--theme-accent)_10%,transparent),transparent_75%)] [mask-image:linear-gradient(to_bottom,transparent,black_16%,black_87%,transparent)] print:hidden"
  aria-hidden="true"
>
  <canvas
    data-hero-shader
    class="block size-full opacity-0 transition-opacity duration-700 ease-[ease] group-data-[ready]:opacity-100 motion-reduce:hidden"
  ></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-shader]");
  const shader = canvas?.parentElement;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (canvas && shader && !reducedMotion.matches) {
    const start = async () => {
      try {
        const THREE = await import("three");
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        const camera = new THREE.Camera();
        camera.position.z = 1;
        const root = document.documentElement;
        const uniforms = {
          resolution: { value: new THREE.Vector2(1, 1) },
          time: { value: 0 },
          accent: { value: new THREE.Color() },
          lightMode: { value: 0 },
          parallax: { value: 0 },
          interaction: { value: new THREE.Vector2() },
        };
        const geometry = new THREE.PlaneGeometry(2, 2);
        const material = new THREE.ShaderMaterial({
          uniforms,
          transparent: true,
          depthWrite: false,
          vertexShader: `
            void main() {
              gl_Position = vec4(position, 1.0);
            }
          `,
          fragmentShader: `
            precision highp float;
            uniform vec2 resolution;
            uniform float time;
            uniform vec3 accent;
            uniform float lightMode;
            uniform float parallax;
            uniform vec2 interaction;

            void main() {
              vec2 uv = (gl_FragCoord.xy - resolution * 0.5) / min(resolution.x, resolution.y);
              vec2 center = vec2(0.29 * resolution.x / min(resolution.x, resolution.y), 0.015);
              vec2 glowPosition = uv - center + vec2(0.0, parallax * 0.6) + interaction * 0.6;
              float light = 0.0;

              // The concentric interference lines are adapted from the supplied shader.
              for (int i = 0; i < 6; i++) {
                float n = float(i);
                float depth = n / 5.0;
                vec2 p = uv - center
                  + vec2(0.0, parallax * mix(0.4, 1.2, depth))
                  + interaction * mix(0.35, 1.4, depth);
                float radius = length(p);
                float angle = atan(p.y, p.x);
                float orbit = 0.16 + n * 0.091
                  + 0.018 * sin(angle * 3.0 + time * 0.34 + n * 0.8)
                  + 0.012 * sin((p.x + p.y) * 8.0 - time * 0.22);
                float line = 0.0018 / (abs(radius - orbit) + 0.0025);
                float dash = 0.4 + 0.6 * smoothstep(-0.4, 0.8,
                  sin(angle * 2.0 + n * 1.7 - time * 0.18));
                float ringFade = 1.0 - smoothstep(0.6, 0.98, radius);
                light += line * dash * ringFade * (0.38 + n * 0.055);
              }

              float glowRadius = length(glowPosition);
              float bloom = 0.17 / (0.15 + glowRadius * glowRadius * 4.0);
              float leftFade = smoothstep(-0.65, 0.0, uv.x);
              float glowFade = 1.0 - smoothstep(0.6, 0.98, glowRadius);
              float intensity = (
                light * mix(1.0, 1.35, lightMode)
                + bloom * glowFade * mix(1.0, 0.18, lightMode)
              ) * leftFade;
              float alpha = min(
                intensity * mix(0.42, 0.2, lightMode),
                mix(0.55, 0.18, lightMode)
              );
              vec3 ink = accent * mix(0.72 + min(light, 1.0) * 0.45, 1.25, lightMode);
              gl_FragColor = vec4(ink, alpha);
            }
          `,
        });
        scene.add(new THREE.Mesh(geometry, material));

        const syncTheme = () => {
          const styles = getComputedStyle(root);
          const isLight = styles.colorScheme === "light";
          uniforms.accent.value.set(styles.getPropertyValue("--theme-accent").trim());
          // ShaderMaterial does not convert custom uniform colors to display space.
          if (isLight) uniforms.accent.value.convertLinearToSRGB();
          uniforms.lightMode.value = Number(isLight);
          renderer.render(scene, camera);
        };
        const themeObserver = new MutationObserver(syncTheme);
        themeObserver.observe(root, { attributes: true, attributeFilter: ["class"] });
        const scheme = window.matchMedia("(prefers-color-scheme: dark)");
        scheme.addEventListener("change", syncTheme);
        syncTheme();

        const hero = shader.closest<HTMLElement>("[data-cv-hero]");
        let heroTravel = 640;
        let parallaxTarget = 0;
        const syncParallax = () => {
          parallaxTarget = Math.min(window.scrollY / heroTravel, 1) * 0.12;
        };
        window.addEventListener("scroll", syncParallax, { passive: true });

        let targetX = 0;
        let targetY = 0;
        hero?.addEventListener("pointermove", (event) => {
          if (event.pointerType !== "mouse") return;
          const bounds = hero.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width * 2 - 1;
          const y = (event.clientY - bounds.top) / bounds.height * 2 - 1;
          targetX = -x * 0.06;
          targetY = y * 0.045;
        });
        hero?.addEventListener("pointerleave", () => {
          targetX = 0;
          targetY = 0;
        });

        let initialGamma: number | undefined;
        let initialBeta: number | undefined;
        const clamp = (value: number) => Math.max(-1, Math.min(1, value));
        const onOrientation = (event: DeviceOrientationEvent) => {
          if (event.gamma === null || event.beta === null) return;
          initialGamma ??= event.gamma;
          initialBeta ??= event.beta;
          targetX = -clamp((event.gamma - initialGamma) / 25) * 0.075;
          targetY = clamp((event.beta - initialBeta) / 25) * 0.055;
        };
        if (typeof DeviceOrientationEvent !== "undefined") {
          const orientation = DeviceOrientationEvent as typeof DeviceOrientationEvent & {
            requestPermission?: () => Promise<"granted" | "denied">;
          };
          if (!orientation.requestPermission) {
            window.addEventListener("deviceorientation", onOrientation);
          }
        }

        const resize = () => {
          const { width, height } = shader.getBoundingClientRect();
          heroTravel = Math.max(hero?.clientHeight ?? height, 1);
          syncParallax();
          renderer.setSize(width, height, false);
          uniforms.resolution.value.set(canvas.width, canvas.height);
          renderer.render(scene, camera);
        };
        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(shader);
        resize();

        let visible = true;
        let frame = 0;
        const render = (now: number) => {
          frame = 0;
          if (!visible || document.hidden || reducedMotion.matches) return;
          uniforms.time.value = now * 0.001;
          uniforms.parallax.value += (parallaxTarget - uniforms.parallax.value) * 0.16;
          uniforms.interaction.value.x += (targetX - uniforms.interaction.value.x) * 0.12;
          uniforms.interaction.value.y += (targetY - uniforms.interaction.value.y) * 0.12;
          renderer.render(scene, camera);
          shader.dataset.ready = "";
          frame = requestAnimationFrame(render);
        };
        const queueRender = () => {
          if (!frame && visible && !document.hidden && !reducedMotion.matches) frame = requestAnimationFrame(render);
        };
        const stopRender = () => {
          cancelAnimationFrame(frame);
          frame = 0;
        };
        new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          if (visible) queueRender(); else stopRender();
        }).observe(shader);
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) stopRender(); else queueRender();
        });
        reducedMotion.addEventListener("change", () => {
          if (reducedMotion.matches) {
            stopRender();
            delete shader.dataset.ready;
          } else queueRender();
        });
        canvas.addEventListener("webglcontextlost", (event) => {
          event.preventDefault();
          stopRender();
          delete shader.dataset.ready;
        });
        queueRender();
      } catch {
        // The CSS glow remains visible when WebGL is unavailable.
      }
    };
    if ("requestIdleCallback" in window) window.requestIdleCallback(start);
    else setTimeout(start, 0);
  }
</script>
