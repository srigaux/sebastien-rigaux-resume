---
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  fr: {
    light: "Clair",
    dark: "Sombre",
    system: "Système",
    lightAction: "Mode clair. Activer le mode sombre.",
    darkAction: "Mode sombre. Suivre le système.",
    systemAction: "Mode système. Activer le mode clair.",
  },
  en: {
    light: "Light",
    dark: "Dark",
    system: "System",
    lightAction: "Light mode. Switch to dark mode.",
    darkAction: "Dark mode. Follow the system setting.",
    systemAction: "System mode. Switch to light mode.",
  },
}[locale];
---

<button
  type="button"
  data-theme-toggle
  data-label-light={copy.lightAction}
  data-label-dark={copy.darkAction}
  data-label-system={copy.systemAction}
  aria-label={copy.systemAction}
  title={copy.systemAction}
  class="min-h-11 min-w-11 items-center justify-center rounded-sm border border-rule px-2 text-sm font-medium text-ink transition-colors hover:border-accent hover:bg-ink/5 dark:hover:bg-ink/10 xl:px-3"
>
  <span data-theme-option="light" class="items-center gap-2" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" class="size-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
    <span class="hidden xl:inline">{copy.light}</span>
  </span>
  <span data-theme-option="dark" class="items-center gap-2" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" class="size-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.2 15.5A8.5 8.5 0 0 1 8.5 3.8 8.5 8.5 0 1 0 20.2 15.5Z" />
    </svg>
    <span class="hidden xl:inline">{copy.dark}</span>
  </span>
  <span data-theme-option="system" class="items-center gap-2" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" class="size-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" />
    </svg>
    <span class="hidden xl:inline">{copy.system}</span>
  </span>
</button>
