---
import { Check, Monitor, Moon, Sun } from "@lucide/astro";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  fr: {
    label: "Choisir le thème",
    light: "Clair",
    dark: "Sombre",
    system: "Système",
    lightAction: "Thème clair. Choisir un autre thème.",
    darkAction: "Thème sombre. Choisir un autre thème.",
    systemAction: "Thème système. Choisir un autre thème.",
  },
  en: {
    label: "Choose theme",
    light: "Light",
    dark: "Dark",
    system: "System",
    lightAction: "Light theme. Choose another theme.",
    darkAction: "Dark theme. Choose another theme.",
    systemAction: "System theme. Choose another theme.",
  },
}[locale];
---

<details
  data-theme-switcher
  data-label-light={copy.lightAction}
  data-label-dark={copy.darkAction}
  data-label-system={copy.systemAction}
  class="relative"
>
  <summary
    data-theme-summary
    aria-label={copy.systemAction}
    title={copy.systemAction}
    class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-sm border border-rule px-2 text-sm font-medium text-ink transition-colors hover:border-accent hover:bg-ink/5 dark:hover:bg-ink/10 marker:hidden xl:gap-2 xl:px-3"
  >
    <span data-theme-option="light" class="items-center gap-2" aria-hidden="true">
      <Sun class="size-5" />
      <span class="hidden xl:inline">{copy.light}</span>
    </span>
    <span data-theme-option="dark" class="items-center gap-2" aria-hidden="true">
      <Moon class="size-5" />
      <span class="hidden xl:inline">{copy.dark}</span>
    </span>
    <span data-theme-option="system" class="items-center gap-2" aria-hidden="true">
      <Monitor class="size-5" />
      <span class="hidden xl:inline">{copy.system}</span>
    </span>
  </summary>

  <fieldset class="absolute right-0 top-[calc(100%+0.75rem)] z-50 w-44 border border-rule bg-paper p-1.5 shadow-lg shadow-ink/10 dark:shadow-black/30">
    <legend class="sr-only">{copy.label}</legend>
    <label class="flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-sm px-3 text-sm font-medium text-ink hover:bg-ink/5 focus-within:outline-2 focus-within:outline-offset-[-2px] focus-within:outline-accent has-checked:bg-accent/10 has-checked:text-accent dark:hover:bg-ink/10">
      <input type="radio" name="theme" value="light" data-theme-choice class="peer sr-only" />
      <Sun class="size-4" aria-hidden="true" />
      <span>{copy.light}</span>
      <Check class="ml-auto size-4 opacity-0 peer-checked:opacity-100" aria-hidden="true" />
    </label>
    <label class="flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-sm px-3 text-sm font-medium text-ink hover:bg-ink/5 focus-within:outline-2 focus-within:outline-offset-[-2px] focus-within:outline-accent has-checked:bg-accent/10 has-checked:text-accent dark:hover:bg-ink/10">
      <input type="radio" name="theme" value="dark" data-theme-choice class="peer sr-only" />
      <Moon class="size-4" aria-hidden="true" />
      <span>{copy.dark}</span>
      <Check class="ml-auto size-4 opacity-0 peer-checked:opacity-100" aria-hidden="true" />
    </label>
    <label class="flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-sm px-3 text-sm font-medium text-ink hover:bg-ink/5 focus-within:outline-2 focus-within:outline-offset-[-2px] focus-within:outline-accent has-checked:bg-accent/10 has-checked:text-accent dark:hover:bg-ink/10">
      <input type="radio" name="theme" value="system" data-theme-choice class="peer sr-only" />
      <Monitor class="size-4" aria-hidden="true" />
      <span>{copy.system}</span>
      <Check class="ml-auto size-4 opacity-0 peer-checked:opacity-100" aria-hidden="true" />
    </label>
  </fieldset>
</details>
