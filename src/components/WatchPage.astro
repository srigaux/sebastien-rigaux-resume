---
import { FileText, Video, GitFork, Rocket, BookOpen, Wrench, Ellipsis } from "@lucide/astro";
import type { WatchFormat } from "@/lib/watch-model";
import { pageMarkdownPath } from "@/lib/urls";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import Header from "@/components/Header.astro";
import { WATCH_PAGE_SIZE, watchPath, watchLinkTarget } from "@/lib/watch-model";
import { renderSummaryMarkdown } from "@/lib/watch-markdown";
import type { WatchPageProps } from "@/lib/watch-pages";

const { locale, links, topics, topic, page, totalPages } = Astro.props as WatchPageProps;
const t = {
  fr: {
    title: "Veille technologique",
    selectedLabel: "Liens sélectionnés",
    intro: "Une sélection personnelle de liens, outils et idées que je souhaite garder et partager avec mes équipes.",
    all: "Tous les liens",
    topics: "Explorer par sujet",
    empty: "Les premiers liens sélectionnés arrivent bientôt.",
    previous: "Précédent",
    next: "Suivant",
    page: "Page",
    of: "sur",
    source: "Repéré via",
    external: "Ouvrir le lien original",
    selected: "Sélectionné le",
    backToTop: "Retour en haut",
  },
  en: {
    title: "Tech watch",
    selectedLabel: "Selected links",
    intro: "A personal selection of links, tools, and ideas I want to keep and share with my teams.",
    all: "All links",
    topics: "Explore topics",
    empty: "The first selected links are coming soon.",
    previous: "Previous",
    next: "Next",
    page: "Page",
    of: "of",
    source: "Found via",
    external: "Open original link",
    selected: "Selected on",
    backToTop: "Back to top",
  },
}[locale];
const path = watchPath(locale, page, topic?.uid);
const alternatePaths = { fr: watchPath("fr", page, topic?.uid), en: watchPath("en", page, topic?.uid) };
const heading = topic ? `${topic.name} · ${t.title}` : t.title;
const title = page > 1 ? `${heading} · ${t.page} ${page}` : heading;
const baseDescription = topic
  ? `${topic.name}: ${locale === "fr" ? "liens sélectionnés par Sébastien Rigaux" : "links selected by Sébastien Rigaux"}.`
  : t.intro;
const description = page > 1 ? `${baseDescription} ${t.page} ${page} ${t.of} ${totalPages}.` : baseDescription;
const previousPath = page > 1 ? watchPath(locale, page - 1, topic?.uid) : undefined;
const nextPath = page < totalPages ? watchPath(locale, page + 1, topic?.uid) : undefined;
// Keep the endpoints and one neighbor on each side: at most five page links.
const pageNumbers = [...new Set([1, page - 1, page, page + 1, totalPages])]
  .filter((number) => number >= 1 && number <= totalPages).sort((a, b) => a - b);
const intro = topic?.description || (topic
  ? locale === "fr" ? `Mes liens sélectionnés autour de ${topic.name}.` : `My selected links about ${topic.name}.`
  : t.intro);
const site = Astro.site!;
const canonical = new URL(path, site).href;
const breadcrumbs = [
  { name: t.title, path: watchPath(locale) },
  ...(topic ? [{ name: topic.name, path: watchPath(locale, 1, topic.uid) }] : []),
  ...(page > 1 ? [{ name: `${t.page} ${page}`, path }] : []),
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage", "@id": `${canonical}#webpage`, url: canonical,
      name: title, description, inLanguage: locale,
      isPartOf: { "@id": new URL("/#website", site).href },
      mainEntity: { "@id": `${canonical}#links` },
      ...(breadcrumbs.length > 1 && { breadcrumb: { "@id": `${canonical}#breadcrumb` } }),
    },
    ...(breadcrumbs.length > 1 ? [{
      "@type": "BreadcrumbList", "@id": `${canonical}#breadcrumb`,
      itemListElement: breadcrumbs.map((entry, index) => ({
        "@type": "ListItem", position: index + 1, name: entry.name, item: new URL(entry.path, site).href,
      })),
    }] : []),
    {
      "@type": "ItemList", "@id": `${canonical}#links`, numberOfItems: links.length,
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      itemListElement: links.map((link, index) => ({
        "@type": "ListItem", position: (page - 1) * WATCH_PAGE_SIZE + index + 1,
        item: { "@type": "WebPage", url: new URL(watchLinkTarget(link, locale), site).href,
          name: link.title, inLanguage: link.locale },
      })),
    },
  ],
};
const formatIcons = { Article: FileText, Video, Repository: GitFork, Release: Rocket, Documentation: BookOpen, Tool: Wrench, Other: Ellipsis } satisfies Record<WatchFormat, typeof FileText>;
const dateFormatter = new Intl.DateTimeFormat(locale === "fr" ? "fr-BE" : "en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<BaseLayout locale={locale} title={title} description={description} canonicalPath={path} alternatePaths={alternatePaths} markdownPath={pageMarkdownPath(path)} previousPath={previousPath} nextPath={nextPath}>
  <Header locale={locale} firstName="Sébastien" lastName="Rigaux" page="watch" languagePaths={alternatePaths} />
  <main id="main" class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 lg:px-12">
      {page === 1 ? <section class="pt-14 sm:pt-20 lg:pt-24">
        <div aria-hidden="true" class="mb-8 h-0.5 w-20 -rotate-12 bg-accent"></div>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
          <p class="text-base font-semibold tracking-tight text-accent">{topic ? t.title : t.selectedLabel}</p>
          {topic && <a href={watchPath(locale)} class="inline-flex min-h-11 items-center text-sm font-medium text-accent underline-offset-4 hover:underline">← {t.all}</a>}
        </div>
        <h1 class="max-w-5xl break-words font-display text-[clamp(2.25rem,11vw,6rem)] leading-[1.04] font-bold tracking-[-0.04em] text-ink sm:text-[clamp(2.75rem,7vw,6rem)]">{topic ? topic.name : t.title}</h1>
        <p class="mt-7 max-w-[72ch] text-lg leading-[1.8] text-muted sm:text-xl">{intro}</p>
      </section> : <header class="pt-10 sm:pt-12 lg:pt-14">
        {topic && <div class="mb-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
          <p class="text-base font-semibold tracking-tight text-accent">{t.title}</p>
          <a href={watchPath(locale)} class="inline-flex min-h-11 items-center text-sm font-medium text-accent underline-offset-4 hover:underline">← {t.all}</a>
        </div>}
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
          <h1 class="break-words font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{topic?.name || t.title}</h1>
        <p class="shrink-0 text-sm text-muted">{t.page} {page} {t.of} {totalPages}</p>
        </div>
      </header>}

      <div class:list={["grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16", page === 1 ? "pt-8 sm:pt-10 lg:pt-12" : "pt-6 sm:pt-8"]}>
        <section aria-label={topic?.name || t.all} class="min-w-0">
          {links.length === 0 && <p class="border-t border-rule py-12 text-muted">{t.empty}</p>}
          <div class="divide-y divide-rule">
            {links.map((link) => {
              const icon = link.siteIcon || link.discoveredVia?.icon;
              const FormatIcon = formatIcons[link.format];
              const sourceLanguageTitle = locale === "fr" ? `Langue de la source : ${link.sourceLanguage === "EN" ? "anglais" : "français"}` : `Source language: ${link.sourceLanguage === "FR" ? "French" : "English"}`;
              const monogram = new URL(link.url).hostname.replace(/^www\./, "").charAt(0).toUpperCase();
              return <article class="relative isolate py-8 sm:py-10">
                <div>
                    <div class="pointer-events-none relative z-10 mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
                      <time datetime={link.selectedOn} aria-label={`${t.selected} ${dateFormatter.format(new Date(`${link.selectedOn}T00:00:00Z`))}`}>{dateFormatter.format(new Date(`${link.selectedOn}T00:00:00Z`))}</time>
                      <span aria-hidden="true">·</span><span class="inline-flex items-center gap-1.5"><FormatIcon size={14} class="shrink-0" aria-hidden="true" />{link.format}</span>
                      {link.sourceLanguage && link.sourceLanguage.toLowerCase() !== locale && <><span aria-hidden="true">·</span><span class="border border-rule px-1.5 py-0.5 font-semibold tracking-wide" title={sourceLanguageTitle} aria-label={sourceLanguageTitle}>{link.sourceLanguage}</span></>}
                      <span aria-hidden="true">·</span>
                    <a href={watchLinkTarget(link, locale)} aria-label={`${locale === "fr" ? "Permalien" : "Permalink"} : ${link.title}`} class="pointer-events-auto relative z-10 inline-block text-xs text-muted underline decoration-rule underline-offset-4 hover:text-accent focus-visible:outline-accent">{locale === "fr" ? "Permalien" : "Permalink"}</a>
                    </div>
                    <h2 class="pr-8 font-display text-xl font-semibold leading-snug tracking-tight sm:text-2xl" lang={link.textLanguage}>
                      {icon ? <img src={icon.url} alt="" width="24" height="24" loading="lazy" class="pointer-events-none mr-2 inline-block relative -top-0.5 size-6 object-contain align-middle" /> : <span aria-hidden="true" class="pointer-events-none mr-2 relative -top-0.5 inline-flex size-6 items-center justify-center rounded-full bg-accent align-middle font-sans text-sm font-bold text-paper">{monogram}</span>}<ExternalLink href={link.url} newTab stretched aria-label={`${link.title} — ${t.external}`} class="text-ink hover:text-accent">{link.title}</ExternalLink>
                    </h2>
                    <p class="pointer-events-none mt-3 max-w-[72ch] text-base leading-[1.75] text-muted [&_a]:pointer-events-auto [&_a]:relative [&_a]:z-10 [&_a]:underline [&_a]:decoration-rule [&_a:hover]:text-accent [&_strong]:font-semibold [&_em]:italic [&_code]:rounded [&_code]:bg-ink/5 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.9em]" lang={link.textLanguage} set:html={renderSummaryMarkdown(link.summary)} />
                    <div class="pointer-events-none relative z-10 mt-4 flex flex-wrap items-center gap-2">
                      {link.topics.map((item) => <a href={watchPath(locale, 1, item.uid)} class="pointer-events-auto relative z-10 border border-rule px-3 py-1.5 text-xs text-muted no-underline transition-colors hover:border-accent hover:text-accent">{item.name}</a>)}
                    </div>
                    {(link.credit || link.discoveredVia) && <p class="pointer-events-none relative z-10 mt-4 text-xs text-muted">
                      {link.credit && <span lang="en">{link.credit}</span>}
                      {link.credit && link.discoveredVia && <span aria-hidden="true"> · </span>}
                      {link.discoveredVia && <span>{t.source} <a href={link.discoveredVia.url} target="_blank" rel="noopener noreferrer" class="pointer-events-auto relative z-10 underline decoration-rule hover:text-accent">{link.discoveredVia.name}</a></span>}
                    </p>}
                </div>
              </article>;
            })}
          </div>
          {totalPages > 1 && <nav aria-label="Pagination" class="mt-8 grid grid-cols-[1fr_auto_1fr] items-center gap-2 text-sm font-semibold">
            {previousPath ? <a href={previousPath} rel="prev" class="inline-flex min-h-11 items-center justify-self-start text-accent underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"><span aria-hidden="true">←&nbsp;</span>{t.previous}</a> : <span />}
            <span class="whitespace-nowrap text-muted md:hidden" aria-label={`${t.page} ${page} ${t.of} ${totalPages}`}>{page} / {totalPages}</span>
            <ol class="hidden items-center gap-1 md:flex">
            {pageNumbers.map((number, index) => <>
              {index > 0 && number > pageNumbers[index - 1] + 1 && <li aria-hidden="true" class="px-1 text-muted">…</li>}
              <li><a href={watchPath(locale, number, topic?.uid)} aria-label={`${t.page} ${number}`} aria-current={number === page ? "page" : undefined} class:list={["inline-flex min-h-11 min-w-11 items-center justify-center border px-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent hover:border-accent hover:text-accent", number === page ? "border-accent text-accent" : "border-rule text-muted"]}>{number}</a></li>
            </>)}
            </ol>
            {nextPath ? <a href={nextPath} rel="next" class="inline-flex min-h-11 items-center justify-self-end text-accent underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">{t.next}<span aria-hidden="true">&nbsp;→</span></a> : <span />}
          </nav>}
        </section>

        {topics.length > 0 && <aside class="lg:pt-0" aria-label={t.topics}>
          <h2 class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{t.topics}</h2>
          <div aria-hidden="true" class="mb-6 mt-5 h-0.5 w-12 -rotate-12 bg-accent"></div>
          <div class="flex flex-wrap gap-2 lg:block lg:space-y-1">
            {topics.map((item) => <a href={watchPath(locale, 1, item.uid)} aria-current={topic?.uid === item.uid ? "page" : undefined} class:list={["inline-block px-2 py-1.5 text-sm no-underline transition-colors lg:block", topic?.uid === item.uid ? "border-l-2 border-accent font-semibold text-accent" : "border-l-2 border-transparent text-muted hover:text-accent"]}>{item.name}</a>)}
          </div>
        </aside>}
      </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  </main>
  <footer class="border-t border-rule">
    <div class="mx-auto grid max-w-7xl grid-cols-2 items-center gap-x-4 gap-y-5 px-5 py-8 text-sm text-muted sm:px-8 lg:px-12">
      <p>Sébastien Rigaux</p>
      <a href="#main" class="justify-self-end font-medium text-accent hover:underline">{t.backToTop}</a>
    </div>
  </footer>
</BaseLayout>
