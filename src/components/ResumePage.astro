---
import About from "@/components/About.astro";
import Education from "@/components/Education.astro";
import Experience from "@/components/Experience.astro";
import Header from "@/components/Header.astro";
import Skills from "@/components/Skills.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale, Person } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const person: Person = {
  firstName: "Sébastien",
  lastName: "Rigaux",
  role: {
    fr: "Architecture logicielle · Leadership technique · Produits web et mobiles",
    en: "Software architecture · Engineering leadership · Web and mobile products",
  },
  jobTitle: {
    fr: "Directeur technique (CTO) · Tech Lead",
    en: "CTO · Tech Lead",
  },
  firstExperienceDate: "2012-02-01",
  email: "sebastien@rigaux.be",
  phone: "+32 476 42 08 48",
  address: {
    formatted: "Visé, Belgium",
    zip: "4600",
    locality: "Visé",
    country: "Belgium",
  },
  socialLinks: [
    {
      label: "Github",
      identifier: "/ srigaux",
      url: "https://github.com/srigaux",
    },
    {
      label: "Facebook",
      identifier: "/ srigaux",
      url: "https://facebook.com/srigaux",
    },
    {
      label: "Linkedin",
      identifier: "/ sebastien-rigaux",
      url: "https://linkedin.com/in/sebastien-rigaux",
    },
    {
      label: "Twitter",
      identifier: "/ rigauxse",
      url: "https://twitter.com/rigauxse",
    },
    {
      label: "Instagram",
      identifier: "/ rigauxse",
      url: "https://www.instagram.com/rigauxse/",
    },
  ],
};
const copy = {
  fr: {
    title: "Directeur technique (CTO) et Tech Lead",
    description:
      "Sébastien Rigaux, directeur technique (CTO) et Tech Lead à Visé. Architecture web et mobile, transition IA et accompagnement CTO as a Service.",
    backToTop: "Retour en haut",
  },
  en: {
    title: "CTO and Tech Lead",
    description:
      "Sébastien Rigaux is a CTO and Tech Lead based in Belgium. Software architecture, AI transition and CTO as a Service for web and mobile products.",
    backToTop: "Back to top",
  },
}[locale];
const name = `${person.firstName} ${person.lastName}`;
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  person={person}
>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      root.classList.add("brand-ready");
      window.addEventListener(
        "load",
        () => {
          if (!root.hasAttribute("data-brand-observing"))
            root.classList.remove("brand-ready");
        },
        { once: true },
      );
    })();
  </script>
  <Header
    locale={locale}
    firstName={person.firstName}
    lastName={person.lastName}
  />
  <main class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <About locale={locale} person={person} />
    <Experience locale={locale} />
    <Education locale={locale} />
    <Skills locale={locale} />
  </main>
  <footer class="border-t border-rule">
    <div
      class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-8 text-sm text-muted sm:px-8 lg:px-12"
    >
      <p>{name}</p>
      <a href="#about" class="font-medium text-accent hover:underline"
        >{copy.backToTop}</a
      >
    </div>
  </footer>
  <script>
    import { Observer } from "tailwindcss-intersect/observer";

    const startObserver = () => Observer.start();

    document.addEventListener("astro:page-load", startObserver);
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", startObserver, {
        once: true,
      });
    else startObserver();
  </script>
</BaseLayout>
