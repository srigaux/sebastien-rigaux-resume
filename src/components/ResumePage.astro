---
import About from "@/components/About.astro";
import Education from "@/components/Education.astro";
import Experience from "@/components/Experience.astro";
import Header from "@/components/Header.astro";
import Skills from "@/components/Skills.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale, Person } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const person: Person = {
  firstName: "Sébastien",
  lastName: "Rigaux",
  role: "Full stack web/mobile developer",
  jobTitle: "CTO",
  birthday: "1989-12-22",
  firstExperienceDate: "2012-02-01",
  email: "sebastien@rigaux.be",
  phone: "+1 (236) 858-8811",
  address: {
    formatted: "Vancouver, BC V6J 1A6",
    zip: "BC V6J 1A6",
    locality: "Vancouver",
    country: "Canada",
  },
  socialLinks: [
    { label: "Github", identifier: "/ srigaux", url: "https://github.com/srigaux" },
    { label: "Facebook", identifier: "/ srigaux", url: "https://facebook.com/srigaux" },
    { label: "Linkedin", identifier: "/ sebastien-rigaux", url: "https://linkedin.com/in/sebastien-rigaux" },
    { label: "Twitter", identifier: "/ rigauxse", url: "https://twitter.com/rigauxse" },
    { label: "Instagram", identifier: "/ rigauxse", url: "https://www.instagram.com/rigauxse/" },
  ],
};
const copy = {
  fr: {
    title: "CTO et développeur web et mobile",
    description:
      "Sébastien Rigaux, directeur de la technologie et développeur web et mobile full stack. Parcours, études et compétences.",
    backToTop: "Retour en haut",
  },
  en: {
    title: "CTO and full stack web and mobile developer",
    description:
      "Sébastien Rigaux, Chief Technology Officer and full stack web and mobile developer. Experience, education and skills.",
    backToTop: "Back to top",
  },
}[locale];
const name = `${person.firstName} ${person.lastName}`;
---

<BaseLayout locale={locale} title={copy.title} description={copy.description} person={person}>
  <Header locale={locale} name={name} />
  <main class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <About locale={locale} person={person} />
    <Experience locale={locale} />
    <Education locale={locale} />
    <Skills locale={locale} />
  </main>
  <footer class="border-t border-rule">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-8 text-sm text-muted sm:px-8 lg:px-12">
      <p>{name}</p>
      <a href="#about" class="font-medium text-accent hover:underline">{copy.backToTop}</a>
    </div>
  </footer>
</BaseLayout>
