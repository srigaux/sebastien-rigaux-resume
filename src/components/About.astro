---
import Logo from "@/assets/logo.svg";
import ExternalLink from "@/components/ExternalLink.astro";
import { yearsSince } from "@/lib/years";
import type { Locale, Person } from "@/types";

interface Props {
  locale: Locale;
  person: Person;
}

const { locale, person } = Astro.props;
const about = {
  fr: {
    intro:
      "Avec {{experienceYears}} ans d’expérience dans le web et le mobile, je relie vision technique, architecture et exécution. Directeur de la technologie (CTO) et Tech Lead, j’accompagne les équipes de l’idée à la mise en production.",
    paragraphs: [
      "Aujourd’hui, je pilote la transition vers l’IA, accompagne les équipes et aide les clients à prendre leurs décisions techniques en CTO as a Service.",
      "Chez Microsoft à Vancouver, j’ai dirigé l’équipe Voicemail de Teams et Skype for Business sur une plateforme traitant des millions de messages vocaux par jour. Autodidacte et proche du code, je fais aussi de la veille sur React, le frontend, C# et Kubernetes.",
      "En dehors du travail, je passe du temps avec ma famille, j’aime voyager et sortir avec mes amis, et je pratique le hockey sur gazon, le kitesurf et le padel.",
    ],
    socialTitle: "Retrouvez-moi",
    contactTitle: "Contact",
  },
  en: {
    intro:
      "With {{experienceYears}} years of experience in web and mobile, I connect technical vision, architecture and hands-on delivery. As a CTO and Tech Lead, I help teams take products from idea to launch.",
    paragraphs: [
      "Today, I drive the transition to AI, support engineering teams and help clients make technology decisions through CTO as a Service engagements.",
      "At Microsoft in Vancouver, I led the Voicemail team for Teams and Skype for Business on a platform handling millions of messages a day. Self-taught and close to the code, I also keep up with React, frontend development, C# and Kubernetes.",
      "Outside work, I spend time with my family, travel, go out with friends, and enjoy field hockey, kitesurfing and padel.",
    ],
    socialTitle: "Find me online",
    contactTitle: "Contact",
  },
}[locale];
const introParts = about.intro.split(/(\{\{experienceYears\}\})/g);
const experienceYears = yearsSince(person.firstExperienceDate);
---

<section id="about" aria-labelledby="name" class="pb-16 pt-14 sm:pb-20 sm:pt-20 lg:pb-24 lg:pt-24">
  <div>
    <div no-intersect class="intersect:opacity-100 intersect:translate-y-0 intersect-once transition-[opacity,translate] duration-[440ms] ease-[cubic-bezier(0.23,1,0.32,1)] motion-safe:opacity-0 [@media(scripting:none)]:opacity-100 motion-safe:translate-y-5 [@media(scripting:none)]:translate-y-0">
      <div aria-hidden="true" class="mb-8 h-0.5 w-20 -rotate-12 bg-accent"></div>
      <p class="mb-4 text-base font-semibold tracking-tight text-accent">{person.jobTitle[locale]}</p>
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_9rem] lg:items-center lg:gap-8 xl:grid-cols-[minmax(0,1fr)_11rem] xl:gap-12">
        <h1 id="name" class="font-display text-[clamp(3.25rem,calc(1.5rem+9vw),8rem)] leading-[0.98] font-bold tracking-[-0.04em] text-ink">
          {person.firstName}<br /><span class="text-accent">{person.lastName}</span>
        </h1>
        <Logo data-hero-logo class="hidden w-full text-accent lg:block" aria-hidden="true" />
      </div>
      <p class="mt-7 max-w-[38rem] text-lg leading-relaxed text-muted sm:text-xl">{person.role[locale]}</p>
    </div>
  </div>

  <div class="mt-14 grid gap-10 border-t border-rule pt-10 lg:mt-20 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-20 lg:pt-12">
    <div no-intersect class="intersect:opacity-100 intersect:translate-y-0 intersect-once transition-[opacity,translate] duration-[360ms] ease-[cubic-bezier(0.23,1,0.32,1)] motion-safe:opacity-0 [@media(scripting:none)]:opacity-100 motion-safe:translate-y-4 [@media(scripting:none)]:translate-y-0 max-w-[72ch] space-y-5 text-base leading-[1.9] text-muted sm:text-lg">
      <p class="font-display text-xl leading-[1.55] font-medium tracking-[-0.015em] text-ink sm:text-2xl">
        {introParts.map((part) =>
          part === "{{experienceYears}}" ? (
            <span data-years-since={person.firstExperienceDate}>{experienceYears}</span>
          ) : (
            part
          ),
        )}
      </p>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <aside no-intersect class="intersect:opacity-100 intersect:translate-y-0 intersect-once transition-[opacity,translate] duration-[360ms] ease-[cubic-bezier(0.23,1,0.32,1)] motion-safe:opacity-0 [@media(scripting:none)]:opacity-100 motion-safe:translate-y-4 [@media(scripting:none)]:translate-y-0 grid gap-9 border-t border-rule pt-8 sm:grid-cols-2 sm:gap-10 lg:block lg:border-t-0 lg:pt-0">
      <div>
        <h2 class="mb-4 text-sm font-semibold text-ink">{about.contactTitle}</h2>
        <address class="space-y-2 text-sm leading-relaxed not-italic text-muted">
          <p>{person.address.formatted}</p>
          <p><ExternalLink class="inline-block break-all hover:text-accent focus-visible:text-accent" href={`tel:${person.phone.replace(/[^\d+]/g, "")}`}>{person.phone}</ExternalLink></p>
          <p><ExternalLink class="inline-block break-all hover:text-accent focus-visible:text-accent" href={`mailto:${person.email}`}>{person.email}</ExternalLink></p>
        </address>
      </div>
      <div class="lg:mt-10">
        <h2 class="mb-4 text-sm font-semibold text-ink">{about.socialTitle}</h2>
        <ul class="space-y-2">
          {person.socialLinks.map((link) => (
            <li>
              <ExternalLink
                href={link.url}
                newTab
                class="group inline-flex items-baseline gap-2 text-sm text-muted hover:text-accent focus-visible:text-accent"
              >
                <span class="font-semibold text-ink group-hover:text-accent group-focus-visible:text-accent">{link.label}</span>
                <span>{link.identifier}</span>
              </ExternalLink>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>

<script>
  import { yearsSince } from "@/lib/years";

  document.querySelectorAll<HTMLElement>("[data-years-since]").forEach((element) => {
    const date = element.dataset.yearsSince;
    if (date) element.textContent = String(yearsSince(date));
  });
</script>
